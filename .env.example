# Modelo de referência. Copie os exemplos para cada app (veja README).
# Somente URL e chave publicável; nunca service_role no cliente.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URLs privadas do Postgres para ferramentas de banco/migrations. Não use no app.
# Substitua [YOUR-PASSWORD] e <PROJECT_REF> localmente; nunca faça commit delas.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@<POOLER_HOST>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@<POOLER_HOST>:5432/postgres
